{
  "name": "pg-storage-rotator",
  "version": "0.0.0",
  "description": "Moves partitioned PostgreSQL data between storage tiers by age: hot, warm, archive.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:docker": "DOCKER_E2E=1 vitest run test/e2e",
    "typecheck": "tsc --noEmit",
    "storage:generate": "tsx src/cli/storage-generate.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
