# Change the env file and run: npm run storage:generate -- --env .env.local

FROM postgres:18

# These directories exist and belong to postgres before any volume is mounted on them, so a new
# named volume inherits that owner on first use.
RUN install -d -o postgres -g postgres -m 700 /mnt/pg/warm /mnt/pg/wal

COPY --chown=postgres:postgres docker/init/ /docker-entrypoint-initdb.d/
